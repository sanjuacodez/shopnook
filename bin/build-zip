#!/usr/bin/env bash
# Build only the runtime files; preserve unrelated output-directory contents.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DIST="${BUILD_OUTPUT:-${ROOT}/../.shopnook-build}"
mkdir -p "$DIST"
DIST="$(cd "$DIST" && pwd)"
SLUG="shopnook-shoppable-images"
STAGE="${DIST}/${SLUG}"
if [[ "$STAGE" == "$ROOT" ]]; then
  echo "Refusing to stage over the source plugin." >&2
  exit 1
fi
if [[ -e "$STAGE" && ! -f "$DIST/.shopnook-build-marker" ]]; then
  echo "Output already contains ${SLUG}/ without a build marker; choose a fresh BUILD_OUTPUT." >&2
  exit 1
fi
printf 'Shopnook generated build directory\n' > "$DIST/.shopnook-build-marker"
mkdir -p "$STAGE"
rsync -a --delete \
  --exclude='.*' --exclude='bin' --exclude='/docs' --exclude='/output' \
  --exclude='/build' --exclude='README.md' --exclude='*.zip' \
  "${ROOT}/" "${STAGE}/"
ARCHIVE="${DIST}/shopnook-candidate-$$.zip"
cd "$DIST"
zip -qr "$ARCHIVE" "$SLUG"
mv -f "$ARCHIVE" "${DIST}/${SLUG}.zip"
echo "Built ${DIST}/${SLUG}.zip"
unzip -l "${SLUG}.zip" | tail -n 2
